PUBLIC_URL=https://feedback.example.com
# openssl rand -base64 32 (each)
POSTGRES_PASSWORD=
OZVI_DB_PASSWORD=
OZVI_SECRET_KEY=
OZVI_SESSION_SECRET=
# Number of reverse proxies in front of Ozvi (Caddy = 1)
OZVI_TRUSTED_PROXIES=1
# Your own SMTP server or provider (Resend, Postmark, SES…). smtp://user:pass@smtp.example.com:587  (empty = e-mails are skipped)
# …or Ecomail's transactional API instead of SMTP (paid account, verified sending domain):
ECOMAIL_API_KEY=
SMTP_URL=
OZVI_MAIL_FROM=feedback@example.com
# Optional S3-compatible storage for attachments (otherwise the "uploads" volume)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional AI writing help (summaries, changelog drafts, weekly digest, post translation). Docs: docs/SELFHOST.md
# OZVI_AI_PROVIDER: anthropic | openai (any OpenAI-compatible API: OpenAI, Mistral, Azure, OpenRouter, Groq, Ollama, vLLM, LM Studio) | off
#   OpenAI:  OZVI_AI_PROVIDER=openai  OZVI_AI_API_KEY=sk-…  OZVI_AI_MODEL=gpt-4o-mini
#   Mistral: OZVI_AI_PROVIDER=openai  OZVI_AI_BASE_URL=https://api.mistral.ai/v1  OZVI_AI_API_KEY=…  OZVI_AI_MODEL=mistral-small-latest
#   Ollama:  OZVI_AI_PROVIDER=openai  OZVI_AI_BASE_URL=http://ollama:11434/v1  OZVI_AI_MODEL=qwen2.5:14b  (no key)
#   Claude:  OZVI_AI_PROVIDER=anthropic  OZVI_AI_API_KEY=sk-ant-…  (model defaults to claude-opus-5-5)
# OZVI_AI_MODEL_FAST: optional cheaper model for translations (default OZVI_AI_MODEL). Empty provider = AI off.
OZVI_AI_PROVIDER=
OZVI_AI_API_KEY=
OZVI_AI_BASE_URL=
OZVI_AI_MODEL=
OZVI_AI_MODEL_FAST=
# Optional AI duplicate detection: any OpenAI-compatible embeddings API (OpenAI, Ollama, LM Studio…).
# Without it Ozvi uses fuzzy text similarity. Ollama example: http://ollama:11434/v1 + nomic-embed-text
# With OZVI_AI_PROVIDER=openai, OZVI_EMBEDDINGS_URL/_KEY may stay empty: the AI base URL and key are reused.
OZVI_EMBEDDINGS_URL=
OZVI_EMBEDDINGS_MODEL=
OZVI_EMBEDDINGS_KEY=

# Fonts are always served from this server (visitors never contact Google). Optional:
# OZVI_FONTS_PREFETCH=1  download the font catalogue at startup
# OZVI_FONTS_REMOTE=0    never contact Google from the server either (disk cache or system fonts)
OZVI_FONTS_PREFETCH=
OZVI_FONTS_REMOTE=

# Image to run. ":1" = fixes and new features of 1.x, never a breaking 2.0 (that needs ":2" here).
# Pin an exact version (":1.4.2") to never move; ":latest" follows everything.
OZVI_IMAGE=ghcr.io/xzamiska/ozvi:1
# Operators: may create accounts and get the update e-mails (comma-separated); language of those e-mails.
OZVI_ADMIN_EMAILS=
OZVI_ADMIN_LOCALE=sk

# Optional updater: Admin → Aktualizácie gets a mode (notify / on request / automatic) and an "Update" button.
# Every update backs up the database to ./backups first and rolls back when the new version is not healthy.
# It needs the Docker socket, i.e. control of this server. Enable it with:
# COMPOSE_PROFILES=updater
# OZVI_UPDATER_URL=http://updater:8787
# OZVI_UPDATER_TOKEN=            # openssl rand -hex 32 (shared by ozvi and updater)
# OZVI_UPDATE_MODE=manual         # notify | manual | auto (initial value; later changed in the admin)
# OZVI_UPDATE_WINDOW=02:00-05:00  # automatic mode only, in TZ
# TZ=Europe/Bratislava
# OZVI_DIR=/opt/ozvi              # absolute path of this directory (defaults to $PWD when you run compose)
# Only when you mirror the images to your own private registry:
# OZVI_REGISTRY=registry.example.com
# OZVI_REGISTRY_USER=
# OZVI_REGISTRY_TOKEN=
