# One environment: copy to .env in its own directory (e.g. /srv/ozvi/live, /srv/ozvi/staging).
OZVI_ENV=staging
OZVI_DOMAIN=staging.ozvi.io
# Live only: where customers point the CNAME of their own domain (A record of the edge IP).
OZVI_CNAME_TARGET=
OZVI_IMAGE=ghcr.io/xzamiska/ozvi:1
# openssl rand -hex 32 (each)
POSTGRES_PASSWORD=
OZVI_DB_PASSWORD=
OZVI_SECRET_KEY=
OZVI_SESSION_SECRET=
# Resend over SMTP: smtp://resend:<API_KEY>@smtp.resend.com:587 (domain ozvi.io verified)
SMTP_URL=
OZVI_MAIL_FROM=Ozvi <noreply@ozvi.io>
# Creem (CREEM_TEST=1 uses the sandbox; staging always)
CREEM_TEST=1
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_PRO_YEAR=
CREEM_PRODUCT_PRO_QUARTER=
CREEM_PRODUCT_STUDIO_YEAR=
CREEM_PRODUCT_STUDIO_QUARTER=
# AI (Studio plan): Scaleway Generative APIs, Paris (EU). Any OpenAI-compatible API works the same way.
OZVI_AI_PROVIDER=openai
OZVI_AI_BASE_URL=https://api.scaleway.ai/v1
OZVI_AI_API_KEY=
OZVI_AI_MODEL=qwen3.8-27b
OZVI_EMBEDDINGS_MODEL=bge-multilingual-gemma2
TZ=Europe/Bratislava
BACKUP_KEEP=14
