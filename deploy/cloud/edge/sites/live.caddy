# Live: the apex, <slug>.<domain> and customers' own domains.
{$LIVE_DOMAIN} {
	import live
}

# www is a reserved slug: send it to the apex instead of a missing board.
# On demand like the rest of *.domain: Caddy leaves names under a wildcard site to that site's certificates.
www.{$LIVE_DOMAIN} {
	tls {
		on_demand
	}
	redir https://{$LIVE_DOMAIN}{uri} permanent
}

*.{$LIVE_DOMAIN} {
	tls {
		on_demand
	}
	import live
}

# Customers' own domains (CNAME to OZVI_CNAME_TARGET), live only.
https:// {
	tls {
		on_demand
	}
	import live
}
