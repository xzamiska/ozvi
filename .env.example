# self | cloud — same image, cloud enables billing, ozvi.io subdomains, magic-link accounts
OZVI_MODE=self
DATABASE_URL=postgres://ozvi:ozvi@localhost:5446/ozvi
PUBLIC_URL=http://localhost:3300
# Shared secret the host app uses to sign SSO tokens (@ozvi/sdk signOzviToken)
OZVI_SSO_SECRET=change-me-at-least-32-characters-long
SMTP_URL=smtp://localhost:1046
# Encrypts secrets at rest (per-project SSO secrets). openssl rand -base64 48
OZVI_SECRET_KEY=dev-only-secret-key-change-me-0123456789abcdef
# Signs session cookies. openssl rand -base64 48
OZVI_SESSION_SECRET=dev-only-session-secret-change-me-0123456789
# Dev only: /dev/login and /demo (never in cloud)
OZVI_DEV_LOGIN=1
OZVI_STORAGE_DIR=./data/uploads
OZVI_MAIL_FROM=noreply@ozvi.localhost
