{
  "name": "@ozvi/updater",
  "version": "0.0.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "description": "Optional self-host sidecar: backs up the database, pulls the next Ozvi image, checks health and rolls back on failure.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/updater.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "vitest": "5"
  }
}
