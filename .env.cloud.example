# Local cloud mode (`pnpm dev:cloud`): these values override .env.
# Runs next to `pnpm dev` (self mode on :3300) with its own database and build dir.
OZVI_MODE=cloud
# *.localhost resolves to 127.0.0.1 in Chrome/Firefox/curl; its own host keeps cookies apart from :3300.
PUBLIC_URL=http://ozvi.localhost:3400
OZVI_CLOUD_DOMAIN=ozvi.localhost
OZVI_DEV_PORT=3400
OZVI_NEXT_DIST=.next-cloud
DATABASE_URL=postgres://ozvi:ozvi@localhost:5446/ozvi_cloud
OZVI_STORAGE_DIR=./data/uploads-cloud
OZVI_DEV_LOGIN=0
# Payments without Creem: checkout and portal open a simulation page (never in production).
OZVI_DEV_BILLING=1
# Custom domains without DNS: verification passes, put the domain into /etc/hosts (never in production).
OZVI_DEV_DNS=1
# Real Creem sandbox instead: OZVI_DEV_BILLING=0, CREEM_TEST=1, CREEM_API_KEY, CREEM_WEBHOOK_SECRET,
# CREEM_PRODUCT_PRO_YEAR / _PRO_QUARTER / _STUDIO_YEAR / _STUDIO_QUARTER
# AI on the Studio plan (cloud uses Claude): OZVI_AI_PROVIDER=anthropic and OZVI_AI_API_KEY=
