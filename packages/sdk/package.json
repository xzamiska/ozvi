{
  "name": "@ozvi/sdk",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Sign Ozvi SSO tokens in your backend (Node.js, zero dependencies). MIT.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./mask": "./src/mask.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "homepage": "https://ozvi.io/docs/widget#sign-in",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xzamiska/ozvi.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "ozvi",
    "sso",
    "jwt",
    "feedback"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./mask": {
        "types": "./dist/mask.d.ts",
        "import": "./dist/mask.js"
      }
    }
  },
  "engines": {
    "node": ">=18"
  }
}
